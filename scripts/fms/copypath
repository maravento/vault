#!/bin/bash
# maravento.com
#
################################################################################
#
# copypath -- FMS path copy
# FILE: copypath
#
# DESCRIPTION:
# Copies selected paths as a normal desktop user.
#
# USAGE:
# bash copypath [file ...]
#
################################################################################

set -uo pipefail

# ------------------------------------------------------------------------------
# REQUIREMENTS
# ------------------------------------------------------------------------------

# no-root check
if [ "$(id -u)" == "0" ]; then
    if command -v zenity &>/dev/null; then
        zenity --error --title="Copy Path" \
            --text="This script should not be run as root." 2>/dev/null || true
    elif command -v notify-send &>/dev/null; then
        notify-send "Copy Path" "This script should not be run as root." -u critical
    fi
    exit 1
fi

# ------------------------------------------------------------------------------
# MAIN
# ------------------------------------------------------------------------------

# Select clipboard tool
clip_cmd=()
if command -v xclip &>/dev/null; then
    clip_cmd=(xclip -selection clipboard)
elif command -v xsel &>/dev/null; then
    clip_cmd=(xsel --clipboard)
elif command -v wl-copy &>/dev/null; then
    clip_cmd=(wl-copy)
fi

# Detect file manager and get selected paths
selected_paths=""

# Try different file manager environment variables
if [[ -n "${CAJA_SCRIPT_SELECTED_FILE_PATHS:-}" ]]; then
    # Caja (MATE)
    selected_paths="$CAJA_SCRIPT_SELECTED_FILE_PATHS"
elif [[ -n "${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}" ]]; then
    # Nautilus (GNOME)
    selected_paths="$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
elif [[ -n "${NEMO_SCRIPT_SELECTED_FILE_PATHS:-}" ]]; then
    # Nemo (Cinnamon)
    selected_paths="$NEMO_SCRIPT_SELECTED_FILE_PATHS"
elif [[ -n "${THUNAR_SCRIPT_SELECTED_FILE_PATHS:-}" ]]; then
    # Thunar (XFCE) - not standard, but some configs use it
    selected_paths="$THUNAR_SCRIPT_SELECTED_FILE_PATHS"
elif [[ $# -gt 0 ]]; then
    # Fallback: paths passed as arguments (Dolphin, PCManFM, others).
    # One path per line, like the file manager variables deliver them,
    # so a path containing blanks keeps its boundary.
    selected_paths=$(printf '%s\n' "$@")
else
    # No files selected
    if command -v zenity &>/dev/null; then
        zenity --error --text="No files selected.\n\nPlease select a file or folder and try again." --width=350 --title="Copy Path"
    elif command -v notify-send &>/dev/null; then
        notify-send "Copy Path Error" "No files selected" -u normal
    fi
    exit 1
fi

# Decode file URIs while preserving literal paths.
selected_paths=$(printf '%s' "$selected_paths" | python3 -c '
import sys
from urllib.parse import unquote_to_bytes

prefix = b"file://"
paths = sys.stdin.buffer.read().split(b"\n")
sys.stdout.buffer.write(b"\n".join(
    unquote_to_bytes(path[len(prefix):]) if path.startswith(prefix) else path
    for path in paths
))
') || exit 1

# Validate that we have actual paths
if [[ -z "$selected_paths" ]]; then
    if command -v zenity &>/dev/null; then
        zenity --error --text="Could not retrieve file path.\n\nFile manager may not be supported." --width=350 --title="Copy Path"
    elif command -v notify-send &>/dev/null; then
        notify-send "Copy Path Error" "Could not retrieve file path" -u normal
    fi
    exit 1
fi

# Copy to clipboard
clip_error=""
if (( ${#clip_cmd[@]} == 0 )); then
    clip_error="No clipboard tool found. Install xclip, xsel, or wl-copy."
elif ! printf '%s' "$selected_paths" | "${clip_cmd[@]}"; then
    clip_error="Could not copy paths to the clipboard."
fi
if [[ -n "$clip_error" ]]; then
    printf '%s\n' "$clip_error" >&2
    if command -v zenity &>/dev/null; then
        zenity --error --title="Copy Path" --text="$clip_error" 2>/dev/null || true
    elif command -v notify-send &>/dev/null; then
        notify-send "Copy Path Error" "$clip_error" -u critical
    fi
    exit 1
fi

# ------------------------------------------------------------------------------
# END
# ------------------------------------------------------------------------------

# Show success notification
if command -v zenity &>/dev/null; then
    # Truncate long paths for display
    display_paths="$selected_paths"
    if [[ ${#display_paths} -gt 200 ]]; then
        display_paths="${display_paths:0:200}..."
    fi
    zenity --info --text="Path(s) copied to clipboard:\n\n$display_paths" --timeout=2 --width=400 --title="Copy Path" 2>/dev/null || true
elif command -v notify-send &>/dev/null; then
    notify-send "Copy Path" "Path(s) copied to clipboard" -t 2000
fi

exit 0
