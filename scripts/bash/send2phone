#!/bin/bash
# maravento.com
#
################################################################################
#
# Send files to phone with KDE Connect (Universal file manager support)
#
# Nautilus Path: ~/.local/share/nautilus/scripts or ~/.config/nautilus/scripts
# Caja Path: ~/.config/caja/scripts
# Thunar Path: ~/.local/share/Thunar/scripts or ~/.config/Thunar/scripts
# Nemo Path: ~/.local/share/nemo/scripts
#
# Check kdeconnect-cli options
# https://linuxcommandlibrary.com/man/kdeconnect-cli
#
################################################################################

set -uo pipefail

# check no-root
if [ "$(id -u)" == "0" ]; then
    echo "[ERROR] This script should not be run as root."
    exit 1
fi

echo "Start KDE Connect Send. Wait..."

# check dependencies
for pkg in kdeconnect-cli; do
  dpkg -s "$pkg" &>/dev/null || command -v "$pkg" &>/dev/null || {
    echo "'$pkg' is not installed. Run:"
    echo "sudo apt install $pkg"
    exit 1
  }
done

files=()
if [ -n "${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}" ]; then
    IFS=$'\n' read -d '' -r -a files <<< "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
elif [ -n "${THUNAR_SELECTION:-}" ]; then
    IFS=$'\n' read -d '' -r -a files <<< "$THUNAR_SELECTION"
elif [ -n "${NEMO_SCRIPT_SELECTED_FILE_PATHS:-}" ]; then
    IFS=$'\n' read -d '' -r -a files <<< "$NEMO_SCRIPT_SELECTED_FILE_PATHS"
elif [ "$#" -gt 0 ]; then
    files=("$@")
else
    echo "Usage: $0 file [file...]"
    echo "Or run from your file manager's context menu"
    exit 1
fi
if [ "${#files[@]}" -eq 0 ]; then
    echo "No files selected"
    exit 1
fi
devices="$(kdeconnect-cli -a 2>/dev/null)"
if [[ -z "$devices" ]]; then
    echo "No connected or accessible kdeconnect devices found"
    echo "Make sure KDE Connect is running and your device is paired and reachable"
    exit 1
fi
mapfile -t phone_ids < <(kdeconnect-cli -a --id-only 2>/dev/null)
if [ "${#phone_ids[@]}" -eq 0 ]; then
    echo "Could not determine phone ID"
    exit 1
elif [ "${#phone_ids[@]}" -eq 1 ]; then
    phone_id="${phone_ids[0]}"
    echo "Using device: $phone_id"
else
    echo "Multiple devices found:"
    echo "$devices"
    printf "\n"
    read -rp "Enter the device ID to use: " phone_id
    if ! printf '%s\n' "${phone_ids[@]}" | grep -qxF "$phone_id"; then
        echo "Invalid device ID"
        exit 1
    fi
fi
printf "\n"
total_files="${#files[@]}"
current=0
sent=0
for file in "${files[@]}"; do
    current=$((current + 1))
    base="$(basename -- "$file")"

    echo "[$current/$total_files] Sending: $base"

    if [ -d "$file" ]; then
        echo "Skipping directory: $base"
        continue
    fi

    if [ ! -f "$file" ]; then
        echo "File not found: $file"
        continue
    fi

    if kdeconnect-cli --device "$phone_id" --share "$file" 2>/dev/null; then
        echo "File sent: $base"
        sent=$((sent + 1))
    else
        echo "Error sending file: $base"
    fi

    if [ $current -lt $total_files ]; then
        sleep 2
    fi
done
printf "\n"
echo "Done. Sent $sent of $total_files file(s)"
