#!/bin/bash
# maravento.com
#
################################################################################
#
# Launch MEGAsync Instances
# Tested: Ubuntu 24.04 LTS
# Fork: https://github.com/NicoVarg99/MEGA-Instances

# Dependencies:
# sudo apt install zenity libatk-adaptor libgail-common libgtk2.0-0 (or libgtk2.0-0t64 for Ubuntu 24.04)
# Download and Install:
# sudo wget -O /usr/bin/msyncs https://raw.githubusercontent.com/maravento/vault/master/scripts/bash/msyncs
# sudo chmod 755 /usr/bin/msyncs
# Run:
# msyncs start|stop|status
# Remove:
# sudo rm -rf /home/$USER/.config/msyncs /usr/bin/msyncs
#
################################################################################

set -uo pipefail

# no-root check
if [ "$(id -u)" == "0" ]; then
    echo "[ERROR] This script should not be run as root."
    exit 1
fi

echo "MEGAsync Instances Starting. Wait..."

# check dependencies
DEPENDENCIES=("zenity" "libatk-adaptor" "libgail-common" "libgtk2.0-0")
for dep in "${DEPENDENCIES[@]}"; do
  if [[ "$dep" == "libgtk2.0-0" ]]; then
    # Check for both libgtk2.0-0 and libgtk2.0-0t64
    if ! dpkg-query -W -f='${Status}' "libgtk2.0-0" 2>/dev/null | grep -q "install ok installed" && \
       ! dpkg-query -W -f='${Status}' "libgtk2.0-0t64" 2>/dev/null | grep -q "install ok installed"; then
      echo "Dependency 'libgtk2.0-0' or 'libgtk2.0-0t64' is not installed. Aborting"
      exit 1
    fi
  else
    if ! dpkg-query -W -f='${Status}' "$dep" 2>/dev/null | grep -q "install ok installed"; then
      echo "Dependency '$dep' is not installed. Aborting"
      exit 1
    fi
  fi
done

# Check if MEGAsync is installed
for pkg in megasync; do
  dpkg -s "$pkg" &>/dev/null || command -v "$pkg" &>/dev/null || {
    echo "'$pkg' is not installed. Run:"
    echo "sudo apt install $pkg"
    exit 1
  }
done

# Variables
real_home="$HOME"
mega_dir="MEGA"
file_path="$real_home/.config/msyncs"
status_file="$file_path/status"
err_flag=0
echo "real_home = $real_home"
unset QT_SCALE_FACTOR 2>/dev/null
export NO_AT_BRIDGE=1
export QT_ACCESSIBILITY=0

# Function to run zenity silently
zenity () {
  /usr/bin/zenity "$@" 2>/dev/null
}

# Function to check dependencies
checkDep () {
  if [[ $(whereis "$1") == "$1:" ]]; then
    >&2 echo "Dependency '$1' seems to be missing"
    err_flag=1
  fi
}

# Function to create a Desktop Entry and set it to start at system startup
generateDesktopEntry () {
  desktop_entry_path="$real_home/.config/autostart/msyncs.desktop"
  mkdir -p "$real_home/.config/autostart"
  echo "[Desktop Entry]" > "$desktop_entry_path"
  echo "Type=Application" >> "$desktop_entry_path"
  echo "Exec=/usr/bin/msyncs start" >> "$desktop_entry_path"
  echo "Name=msyncs" >> "$desktop_entry_path"
  echo "Comment=Open all your MEGAsync instances" >> "$desktop_entry_path"
  echo "Icon=/usr/share/icons/hicolor/256x256/apps/mega.png" >> "$desktop_entry_path"
  echo "Hidden=false" >> "$desktop_entry_path"
  chmod +x "$desktop_entry_path"
}

# Installation function
start () {
  # prevent overlapping runs
  script_lock="/var/lock/$(basename "$0" .sh).lock"
  (umask 077; : >> "$script_lock")
  exec 200>"$script_lock"
  if ! flock -n 200; then
    echo "[ERROR] Script $(basename "$0") is already running"
    exit 1
  fi

  checkDep "zenity"
  checkDep "megasync"

  if [[ $err_flag -ne 0 ]]; then
    >&2 echo "Error: Install all required dependencies before running MEGAsync Instances"
    exit 1
  fi

  frun
}

# Start MEGAsync
frun () {
    if [ -f "$status_file" ]; then
        if [ "$(cat "$status_file")" == "1" ]; then
            echo "MEGAsync Instances are already configured, launching the instances..."
            killall megasync 2> /dev/null # Close open megasync instances

            # Launch each instance in its corresponding folder
            for d in "$real_home/$mega_dir"/*/ ; do
                echo "Launching $(basename "$d")"
                (exec 200>&-; export HOME="$d"; nohup megasync >/dev/null 2>&1 &)
            done
            exit 0
        fi
    fi

    echo "MEGAsync Instances are not configured. Will now start the configuration."

    if zenity --question --no-wrap --text="This is the first time you are running MEGAsync Instances.\nIn order to continue we must delete your existing MEGAsync instance.\nPress Yes to continue, No to abort."; then
        killall megasync 2>/dev/null
        rm -f "$real_home/.config/autostart/msyncs.desktop"
        rm -rf "$real_home/$mega_dir"
        rm -rf "$file_path"
    else
        exit
    fi

    # Initialize inst_num
    inst_num=0

    # 1-9 number
    while [[ ! $inst_num =~ ^[1-9]$ ]]; do
        inst_num=$(zenity --entry --text="How many MEGAsync instances do you need? (1-9)") || { echo "Cancelled."; exit 0; }

        # check valid number
        if [[ ! $inst_num =~ ^[1-9]$ ]]; then
            zenity --error --text="Please enter a valid number between 1 and 9."
        fi
    done

    mkdir -p "$real_home/$mega_dir"

    for (( i=1; i<=inst_num; i++ )); do
        instance_name=""
        while [[ -z "$instance_name" ]]; do
            instance_name=$(zenity --entry --text="Insert the name for instance $i/$inst_num") || { echo "Cancelled."; exit 0; }
            if [[ -z "$instance_name" ]]; then
                zenity --error --text="Instance name cannot be empty."
            fi
        done
        instance_array[$i]="$instance_name"
        mkdir -p "$real_home/$mega_dir/$instance_name"
    done

    # Required Environment Variables
    export GTK_MODULES="gail:atk-bridge"
    export QT_QPA_PLATFORMTHEME="gtk2"

    for (( i=1; i<=inst_num; i++ )); do
        (exec 200>&-; export HOME="$real_home/$mega_dir/${instance_array[$i]}"; nohup megasync >/dev/null 2>&1 &)
        sleep 2
        zenity --warning --width=400 \
            --text=" INSTANCE ${instance_array[$i]} ($i/$inst_num) \n\n--------------------------------\nDO NOT CLICK OK UNTIL YOU HAVE\nFINISHED CONFIGURING THIS ACCOUNT\nOR IT WILL BE CLOSED AND LOST\n--------------------------------\n\nLog in to your MEGA account\nComplete the configuration\nClose MEGAsync\nTHEN click OK to continue"
        killall megasync 2>/dev/null
        sleep 1
    done

    generateDesktopEntry

    mkdir -p "$file_path"
    echo 1 > "$status_file"
    zenity --info --text="All instances configured. Restarting MEGAsync Instances..."
    echo "Restarting MEGAsync Instances..."
    exec /usr/bin/msyncs start
}

# Stop MEGAsync
stop() {
    echo "Stopping MEGAsync Instances..."
    killall megasync 2>/dev/null # Close MEGAsync instances
    echo "MEGAsync Instances stopped."
}

# Show status of MEGAsync
status () {
  if pidof megasync > /dev/null; then
    echo "MEGAsync is running."
  else
    echo "MEGAsync is not running."
  fi
}

# Create configuration file if missing
if [ ! -f "$status_file" ]; then
  mkdir -p "$file_path"
  echo 0 > "$status_file"
fi

# Handle script arguments
case "${1:-}" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  status)
    status
    ;;
  *)
    echo "Usage: $0 {start|stop|status}"
    exit 1
    ;;
esac
